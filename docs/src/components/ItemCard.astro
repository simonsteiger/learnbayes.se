---
import { Icon } from 'astro-icon/components';
import type { ItemChip, Level } from '@lib/items';

export interface Props {
	id: string;
	href: string;
	title: string;
	description?: string;
	level?: Level;
	tags: string[];
	chips: ItemChip[];
	text: string;
}

const { id, href, title, description, level, tags, chips, text } = Astro.props;
const levelLabel = level ? { beginner: 'Beginner', advanced: 'Advanced', expert: 'Expert' }[level] : undefined;
---

<article class="lang-card not-content" id={id} data-level={level ?? ''} data-tags={tags.join(',')} data-text={text}>
	<div class="top">
		<div>
			{level && (
				<span class={`level level--${level}`}>
					<span class="dot" aria-hidden="true"></span>
					{levelLabel}
				</span>
			)}
			<h3 class="title"><a class="card-link" href={href}>{title}</a></h3>
			{description && <p class="desc">{description}</p>}
		</div>
		<div class="langs">
			{chips.map((chip) => {
				if (chip.iconUrl) {
					return chip.href ? (
						<a class="lang-chip" href={chip.href} target="_blank" rel="noopener noreferrer" aria-label={`${title} in ${chip.label}`}>
							<img src={chip.iconUrl} alt={chip.label} width="22" height="22" />
						</a>
					) : (
						<span class="lang-chip lang-chip--disabled" aria-disabled="true" title="Not available yet">
							<img src={chip.iconUrl} alt="" aria-hidden="true" width="22" height="22" />
						</span>
					);
				}
				return chip.href ? (
					<a class="lang-chip" href={chip.href} target="_blank" rel="noopener noreferrer" aria-label={`${title}: ${chip.label}`}>
						<Icon name={chip.iconName!} width={22} height={22} />
					</a>
				) : (
					<span class="lang-chip lang-chip--disabled" aria-disabled="true" title={`${chip.label} not available`}>
						<Icon name={chip.iconName!} width={22} height={22} />
					</span>
				);
			})}
		</div>
	</div>
	<div class="bottom">
		<div class="tags">
			{tags.map((tag) => (
				<button type="button" class="tag" data-facet="tag" data-value={tag} aria-pressed="false">
					{tag}
				</button>
			))}
		</div>
	</div>
</article>

<style lang="scss">
	.lang-card {
		position: relative;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		padding: 1rem 1.15rem;
		background: var(--sl-color-black);
		transition: background-color 0.15s ease, border-color 0.15s ease;

		&:hover {
		    background-color: var(--color-accent-25);
		    border-color: var(--color-accent-25);
		}

		:global([data-theme='dark']) & {
			&:hover {
				background-color: var(--color-accent-950);
				border-color: var(--color-accent-950);
			}
		}

		.card-link {
			color: var(--sl-color-white);
			text-decoration: none;

			&::after {
				content: '';
				position: absolute;
				inset: 0;
				border-radius: 0.6rem;
			}

			&:focus-visible {
				outline: none;

				&::after {
					outline: 2px solid var(--sl-color-accent);
					outline-offset: 2px;
				}
			}
		}

		.langs,
		.tags {
			position: relative;
			z-index: 1;
		}

		.top {
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			gap: 1rem;
		}

		.title {
			margin: 0;
			padding-bottom: 0.2rem;
			font-size: 1.15rem;
		}

		.level {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			font-size: 0.72rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			white-space: nowrap;

			&--beginner { color: var(--level-beginner); }
			&--advanced { color: var(--level-advanced); }
			&--expert { color: var(--level-expert); }
		}

		.dot {
			width: 0.7rem;
			height: 0.7rem;
			border-radius: 50%;
			background: currentColor;
		}

		.desc {
			margin: 0rem 0 0.7rem;
			color: var(--sl-color-gray-3);
			font-size: 0.9rem;
		}

		.bottom {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding-top: 0.2rem;
			gap: 1rem;
		}

		.tags {
			display: flex;
			gap: 0.4rem;
			flex-wrap: wrap;
		}

		.langs {
			display: grid;
			grid-template-columns: repeat(2, auto);
			gap: 0.5rem;
			flex: none;
			justify-content: end;
		}
	}

	.tag {
		font-size: 0.72rem;
		color: var(--sl-color-gray-3);
		background: none;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.35rem;
		padding: 0.12rem 0.55rem;
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease;

		&:hover {
			background-color: var(--color-accent-100);
			border-color: var(--color-accent-100);
		}

		&[aria-pressed='true'] {
			color: var(--color-accent-800);
			background-color: var(--color-accent-200);
			border-color: var(--color-accent-200);
		}

		:global([data-theme='dark']) & {
			&:hover {
				background-color: var(--color-accent-800);
				border-color: var(--color-accent-800);
			}

			&[aria-pressed='true'] {
				color: var(--color-accent-200);
				background-color: var(--color-accent-700);
				border-color: var(--color-accent-700);
			}
		}
	}

	.lang-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.2rem;
		height: 2.2rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		color: var(--sl-color-accent);
		transition: background-color 0.15s ease, border-color 0.15s ease;

		&--disabled {
			opacity: 0.35;
		}

		&:not(.lang-chip--disabled):hover {
			background-color: var(--color-accent-100);
			border-color: var(--color-accent-100);
		}

		:global([data-theme='dark']) & {
			color: var(--color-accent-200);

			&.lang-chip--disabled {
				opacity: 0.5;
				color: var(--sl-color-gray-5);
				border: 1px solid var(--sl-color-gray-5);
			}

			&:not(.lang-chip--disabled):hover {
				background-color: var(--color-accent-800);
				border-color: var(--color-accent-800);
			}
		}
	}
</style>

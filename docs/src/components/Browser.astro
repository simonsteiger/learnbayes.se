---
import ItemCard from '@components/ItemCard.astro';
import { browserConfigs, groupItems, type ItemGroup } from '@lib/browserConfigs';
import { Icon } from 'astro-icon/components';

interface Props {
	kind: 'examples' | 'resources';
}

const { kind } = Astro.props;
const config = browserConfigs[kind];
const cards = await config.load();
const groups: ItemGroup[] = config.groups
	? groupItems(cards, config.groups)
	: [{ slug: '', label: '', items: cards }];

const levels = [
	{ value: 'beginner', label: 'Beginner' },
	{ value: 'advanced', label: 'Advanced' },
	{ value: 'expert', label: 'Expert' },
] as const;

const allTags = [...new Set(cards.flatMap((c) => c.tags))].sort();
---

<div class="browser not-content" data-browser={kind}>
	<div class="console" role="group" aria-label={config.ariaLabel}>
		<div class="head">
			<span class="title">Filters</span>
			<div class="head-actions">
				<button type="button" class="tags-toggle" data-tags-toggle disabled aria-disabled="true" aria-expanded="false">
					<Icon name="ph:eye-duotone" class="tags-toggle-icon" data-tags-toggle-icon="show" />
					<Icon name="ph:eye-slash-duotone" class="tags-toggle-icon is-hidden" data-tags-toggle-icon="hide" />
					Toggle tags
				</button>
				<button type="button" class="reset" data-reset disabled aria-disabled="true">
					<Icon name="ph:arrow-counter-clockwise" class="reset-icon" />
					Clear filters
				</button>
			</div>
		</div>

		<div class="levels">
			<span class="label">Level</span>
			{levels.map((l) => (
				<button type="button" class={`lvl lvl--${l.value}`} data-facet="level" data-value={l.value} aria-pressed="false">
					<span class="lvl__dot" aria-hidden="true"></span>
					{l.label}
				</button>
			))}
		</div>

		<div class="divider"></div>
		<input
			type="search"
			class="search"
			data-search
			placeholder={`Search ${config.itemLabel}s...`}
			aria-label={`Search ${config.itemLabel}s`}
		/>
		<div class="tags-block">
			<span class="label">Tags</span>
			<div class="tags" data-tags-wrap>
				{allTags.map((t) => (
					<button type="button" class="fbtn" data-facet="tag" data-value={t} aria-pressed="false">
						{t}
					</button>
				))}
			</div>
		</div>
		<p class="more" data-more hidden></p>
	</div>

	<p class="browser__status sr-only" role="status" aria-live="polite" data-status />

	{groups.map((group) => (
		<section class="browser__group" data-group={group.slug}>
			{group.label && <h2 class="browser__group-heading" id={group.slug}>{group.label}</h2>}
			<div class="browser__grid">
				{group.items.map((c) => (
					<ItemCard
						id={c.id}
						href={c.href}
						title={c.title}
						description={c.description}
						level={c.level}
						tags={c.tags}
						chips={c.chips}
						text={c.text}
					/>
				))}
			</div>
		</section>
	))}

	<div class="browser__empty" data-empty hidden>
		<p>{config.emptyText}</p>
		<button type="button" class="fbtn" data-reset>Reset filters</button>
	</div>
</div>

<style lang="scss">
	.console {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.7rem;
		// background: var(--color-gray-100);
		padding: 1rem 1.15rem;
		margin: 1rem 0;

		.head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 0.7rem;
		}

		.title {
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			font-weight: 600;
			color: var(--sl-color-gray-3);
		}

		.head-actions {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.reset,
		.tags-toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			font-size: 0.72rem;
			color: var(--sl-color-gray-3);
			background: none;
			border-radius: 0.35rem;
			border: 1px solid var(--sl-color-gray-5);
			cursor: pointer;
			padding: 0.18rem 0.5rem;
			transition: background-color 0.15s ease, border-color 0.15s ease;

			&:not(:disabled):hover {
				background-color: var(--color-accent-100);
				border-color: var(--color-accent-100);
			}

			&:disabled {
				opacity: 0.4;
				cursor: default;
			}

			:global([data-theme='dark']) & {
				&:not(:disabled):hover {
					background-color: var(--color-accent-800);
					border-color: var(--color-accent-800);
				}
			}
		}

		.tags-toggle--nudge:not(:disabled) {
			background-color: var(--color-accent-100);
			border-color: var(--color-accent-100);

			:global([data-theme='dark']) & {
				background-color: var(--color-accent-800);
				border-color: var(--color-accent-800);
			}
		}

		.reset-icon,
		.tags-toggle-icon {
			width: 0.95rem;
			height: 0.95rem;

			&.is-hidden {
				display: none;
			}
		}

		.levels {
			display: flex;
			align-items: center;
			gap: 0.45rem;
			flex-wrap: wrap;
		}

		.divider {
			height: 1px;
			background: var(--sl-color-gray-5);
			margin: 0.8rem 0;
		}

		.search {
			width: 100%;
			box-sizing: border-box;
			background: var(--sl-color-black);
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.4rem;
			padding: 0.35rem 0.6rem;
			font-size: 0.8rem;
			color: var(--sl-color-white);
			margin-bottom: 0.7rem;
			transition: border 0.15s ease, box-shadow 0.15s ease;

			&:focus {
				outline: none;
				border-color: var(--color-accent-800);
				box-shadow: 0 0 0 1px var(--color-accent-800);

				:global([data-theme='dark']) & {
					border-color: var(--color-accent-200);
					box-shadow: 0 0 0 1px var(--color-accent-200);
				}
			}
		}

		.tags-block {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;

			.fbtn {
				margin-right: 0;

				&.is-collapsed {
					display: none;
				}
			}
		}

		.tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
		}

		.label {
			font-size: 0.68rem;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--sl-color-gray-3);
		}

		.more {
			display: block;
			width: 100%;
			box-sizing: border-box;
			margin: 0.6rem 0 0;
			padding: 0.3rem;
			font-size: 0.72rem;
			color: var(--sl-color-gray-3);
			background: none;
			border: 1px dashed var(--sl-color-gray-5);
			border-radius: 0.35rem;
			text-align: center;
			transition: background-color 0.15s ease, border-color 0.15s ease;

			&:hover {
				background-color: var(--color-accent-100);
				border-color: var(--color-accent-100);
				cursor: pointer;
			}

			:global([data-theme='dark']) & {
				&:hover {
					background-color: var(--color-accent-800);
					border-color: var(--color-accent-800);
				}
			}

			&[hidden] {
				display: none;
			}
		}
	}
	.lvl {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: none;
		border: none;
		padding: 0.15rem 0.25rem;
		font-size: 0.74rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		cursor: pointer;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.35rem;
		padding: 0.18rem 0.6rem;

		&__dot {
			width: 0.65rem;
			height: 0.65rem;
			border-radius: 50%;
			background: currentColor;
		}

		&--beginner {
		    color: var(--level-beginner);
			&:hover {
				background-color: var(--level-beginner-lighter);
				border-color: var(--level-beginner-lighter);
			}
			&[aria-pressed='true'] {
			    background-color: var(--level-beginner-light);
				border-color: var(--level-beginner-light);
			}
			:global([data-theme='dark']) & {
                &:hover {
                    background-color: var(--level-beginner-darker);
				    border-color: var(--level-beginner-darker);
			    }
				&[aria-pressed='true'] {
				    background-color: var(--level-beginner-dark);
					border-color: var(--level-beginner-darker);
				}
			}
		}
		&--advanced {
		    color: var(--level-advanced);
			&:hover {
				background-color: var(--level-advanced-lighter);
				border-color: var(--level-advanced-lighter);
			}
			&[aria-pressed='true'] {
			    background-color: var(--level-advanced-light);
				border-color: var(--level-advanced-light);
			}
			:global([data-theme='dark']) & {
                &:hover {
                    background-color: var(--level-advanced-darker);
				    border-color: var(--level-advanced-darker);
			    }
				&[aria-pressed='true'] {
				    background-color: var(--level-advanced-dark);
					border-color: var(--level-advanced-darker);
				}
			}
		}
		&--expert   {
		    color: var(--level-expert);
			&:hover {
				background-color: var(--level-expert-lighter);
				border-color: var(--level-expert-lighter);
			}
			&[aria-pressed='true'] {
			    background-color: var(--level-expert-light);
				border-color: var(--level-expert-light);
			}
			:global([data-theme='dark']) & {
                &:hover {
                    background-color: var(--level-expert-darker);
				    border-color: var(--level-expert-darker);
			    }
				&[aria-pressed='true'] {
				    background-color: var(--level-expert-dark);
					border-color: var(--level-expert-dark);
				}
			}
		}

		&.is-muted {
			color: #666;
			opacity: 0.4;
		}
	}
	.fbtn {
		font-size: 0.74rem;
		color: var(--sl-color-gray-3);
		background: none;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.35rem;
		padding: 0.18rem 0.6rem;
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease;

		&:not(.fbtn:disabled):hover {
			background-color: var(--color-accent-100);
			border-color: var(--color-accent-100);
		}

		&[aria-pressed='true'] {
			color: var(--color-accent-800);
			background-color: var(--color-accent-200);
			border-color: var(--color-accent-200);
		}

		&.is-unavailable {
			opacity: 0.4;
		}

		&:disabled {
			cursor: not-allowed;
		}

		:global([data-theme='dark']) & {
			&[aria-pressed='true'] {
				color: var(--color-accent-200);
				background-color: var(--color-accent-700);
				border-color: var(--color-accent-700);
			}

			&:not(.fbtn:disabled):hover {
				background-color: var(--color-accent-800);
				border-color: var(--color-accent-800);
			}
		}
	}
	.browser__group-heading {
		font-size: var(--sl-text-h2);
		font-weight: 600;
		line-height: var(--sl-line-height-headings);
		color: var(--sl-color-white);
		margin: 2.5rem 0 0;
	}
	.browser__grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 1.4rem;
	}
	.browser__empty {
		text-align: center;
		color: var(--sl-color-gray-3);
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: 0.6rem;
		padding: 2rem;
		margin-top: 0.6rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;

		&[hidden] {
			display: none;
		}
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<script>
	import { initFacetedBrowser } from '@lib/facetedBrowser';
	document.querySelectorAll<HTMLElement>('[data-browser]').forEach((el) =>
		initFacetedBrowser(el, {
			simple: [{ key: 'level', attr: 'level' }],
			collapsible: { key: 'tag', attr: 'tags' },
			searchAttr: 'text',
			cardSelector: '.lang-card',
			itemLabel: el.dataset.browser === 'resources' ? 'resource' : 'example',
		})
	);
</script>

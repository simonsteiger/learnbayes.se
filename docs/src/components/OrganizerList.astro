---
import { getCollection } from "astro:content";
import { LinkCard } from "@astrojs/starlight/components";

const allOrganizers = await getCollection("people", ({ data }) => {
  return data.type == "organizer" && (import.meta.env.PROD
    ? data.draft !== true
    : true);
});
---

{
  allOrganizers
    .sort((a, b) => a.data.title.localeCompare(b.data.title))
    .map((organizer) => (
      <LinkCard title={organizer.data.title} href={`/people/${organizer.id}`} />
    ))
}

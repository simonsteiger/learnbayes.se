---
import { getCollection } from 'astro:content';
import ResourceCard from '@components/ResourceCard.astro';
import { Icon } from 'astro-icon/components';

const levelRank = { beginner: 0, advanced: 1, expert: 2 } as const;

const entries = (await getCollection('resources'))
	.filter((e) => (import.meta.env.PROD ? !e.data.draft : true))
	.sort((a, b) => {
		const rankDiff = (levelRank[a.data.level ?? 'expert']) - (levelRank[b.data.level ?? 'expert']);
		return rankDiff !== 0 ? rankDiff : a.data.title.localeCompare(b.data.title);
	});

const levels = [
	{ value: 'beginner', label: 'Beginner' },
	{ value: 'advanced', label: 'Advanced' },
	{ value: 'expert', label: 'Expert' },
] as const;

const allTags = [...new Set(entries.flatMap((e) => e.data.tags))].sort();
---

{
	<div class="browser not-content" data-resource-browser>
		<div class="console" role="group" aria-label="Filter resources">
			<div class="console__head">
				<span class="console__title">Filters</span>
				<div class="console__head-actions">
					<button type="button" class="console__tags-toggle" data-tags-toggle disabled aria-disabled="true" aria-expanded="false">
						<Icon name="ph:eye-duotone" class="console__tags-toggle-icon" data-tags-toggle-icon="show" />
						<Icon name="ph:eye-slash-duotone" class="console__tags-toggle-icon is-hidden" data-tags-toggle-icon="hide" />
						Toggle tags
					</button>
					<button type="button" class="console__reset" data-reset disabled aria-disabled="true">
						<Icon name="ph:arrow-counter-clockwise" class="console__reset-icon" />
						Clear filters
					</button>
				</div>
			</div>

			<div class="console__levels">
				<span class="console__label">Level</span>
				{levels.map((l) => (
					<button type="button" class={`lvl lvl--${l.value}`} data-facet="level" data-value={l.value} aria-pressed="false">
						<span class="lvl__dot" aria-hidden="true"></span>
						{l.label}
					</button>
				))}
			</div>

			<div class="console__divider"></div>
			<input
				type="search"
				class="console__search"
				data-search
				placeholder="Filter tags..."
				aria-label="Filter tags"
			/>
			<div class="console__tags-block">
				<span class="console__label">Tags</span>
				<div class="console__tags" data-tags-wrap>
					{allTags.map((t) => (
						<button type="button" class="fbtn" data-facet="tag" data-value={t} aria-pressed="false">
							{t}
						</button>
					))}
				</div>
			</div>
		<p class="console__more" data-more hidden></p>
		</div>

		<p class="browser__status sr-only" role="status" aria-live="polite" data-status />

		<div class="browser__grid">
			{entries.map((e) => (
				<ResourceCard
					title={e.data.title}
					description={e.data.description}
					level={e.data.level}
					tags={e.data.tags}
					links={e.data.links}
				/>
			))}
		</div>

		<div class="browser__empty" data-empty hidden>
			<p>No resources match these filters.</p>
			<button type="button" class="fbtn" data-reset>Reset filters</button>
		</div>
	</div>
}

<style>
	.console {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.7rem;
		// background: var(--color-gray-100);
		padding: 1rem 1.15rem;
		margin: 1rem 0;
	}
	.console__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.7rem;
	}
	.console__title {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-weight: 600;
		color: var(--sl-color-gray-3);
	}
	.console__head-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.console__reset,
	.console__tags-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.72rem;
		color: var(--sl-color-gray-3);
		background: none;
		border-radius: 0.35rem;
		border: 1px solid var(--sl-color-gray-5);
		cursor: pointer;
		padding: 0.18rem 0.5rem;
	}
	.console__reset:not(:disabled):hover,
	.console__tags-toggle:not(:disabled):hover {
        background-color: var(--color-accent-100);
        border-color: var(--sl-color-accent);
	}
	:global([data-theme='dark']) .console__tags-toggle:not(:disabled):hover {
        background-color: var(--color-accent-800);
        border-color: var(--sl-color-accent);
	}
	.console__reset:disabled,
	.console__tags-toggle:disabled { opacity: 0.4; cursor: default; }
	.console__reset-icon,
	.console__tags-toggle-icon { width: 0.95rem; height: 0.95rem; }
		.console__tags-toggle-icon.is-hidden { display: none; }
	.console__divider {
		height: 1px;
		background: var(--sl-color-gray-5);
		margin: 0.8rem 0;
	}
	.console__search {
		width: 100%;
		box-sizing: border-box;
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		padding: 0.35rem 0.6rem;
		font-size: 0.8rem;
		color: var(--sl-color-white);
		margin-bottom: 0.7rem;
		transition: border 0.15s ease, box-shadow 0.15s ease;
	}
	.console__search:focus {
        outline: none;
        border-color: var(--sl-color-accent);
        box-shadow: 0 0 0 1px var(--sl-color-accent);
	}
	:global([data-theme='dark']) .console__search:focus {
        outline: none;
        border-color: var(--color-accent-200);
        box-shadow: 0 0 0 1px var(--color-accent-200);
	}
	.console__tags-block .fbtn.is-hidden { display: none; }
	.console__tags-block .fbtn.is-collapsed { display: none; }
	.console__more {
		display: block;
		width: 100%;
		box-sizing: border-box;
		margin: 0.6rem 0 0;
		padding: 0.3rem;
		font-size: 0.72rem;
		color: var(--sl-color-gray-3);
		background: none;
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: 0.35rem;
		text-align: center;
	}
	.console__more[hidden] {
		display: none;
	}
	.console__tags-toggle--nudge:not(:disabled) {
        border-color: var(--sl-color-accent);
	}
	:global([data-theme='dark']) .console__tags-toggle--nudge:not(:disabled) {
        border-color: var(--sl-color-accent);
	}
	.console__levels {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-wrap: wrap;
	}
	.console__tags-block {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.4rem;
	}
	.console__tags-block .fbtn { margin-right: 0; }
	.console__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.console__label {
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-gray-3);
	}
	.lvl {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: none;
		border: none;
		padding: 0.15rem 0.25rem;
		font-size: 0.74rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		cursor: pointer;
	}
	.lvl__dot {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: currentColor;
	}
	.lvl--beginner {
	    color: #009E73;
	}
	.lvl--advanced {
	    color: #E69100;
	}
	.lvl--expert   {
	    color: #B84145;
	}
	.lvl.is-muted  {
	    color: #666;
		opacity: 0.4;
	}
	.fbtn {
		font-size: 0.74rem;
		color: var(--sl-color-gray-3);
		background: none;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.35rem;
		padding: 0.18rem 0.6rem;
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}
	.fbtn:not(.fbtn:disabled):hover {
	    background-color: var(--color-accent-100);
        border-color: var(--sl-color-accent);
	}
	.fbtn[aria-pressed='true'] {
	    color: var(--color-accent-800);
		background-color: var(--color-accent-200);
		border-color: var(--color-accent-800);
	}
	.fbtn.is-unavailable {
		opacity: 0.4;
	}
	.fbtn:disabled {
		cursor: not-allowed;
	}
	.browser__grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 1.4rem;
	}
	.browser__empty {
		text-align: center;
		color: var(--sl-color-gray-3);
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: 0.6rem;
		padding: 2rem;
		margin-top: 0.6rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
	}
	.browser__empty[hidden] {
		display: none;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	:global([data-theme='dark']) .fbtn:not(.fbtn:disabled):hover {
        background-color: var(--color-accent-800);
        border-color: var(--sl-color-accent);
	}
	:global([data-theme='dark']) .fbtn[aria-pressed='true'] {
	    color: var(--color-accent-200);
		background-color: var(--color-accent-800);
		border-color: var(--color-accent-200);
	}
</style>

<script>
	import { initFacetedBrowser } from '@lib/facetedBrowser';
	document.querySelectorAll<HTMLElement>('[data-resource-browser]').forEach((el) =>
		initFacetedBrowser(el, {
			simple: [{ key: 'level', attr: 'level' }],
			collapsible: { key: 'tag', attr: 'tags' },
			cardSelector: '.lang-card',
			itemLabel: 'resource',
		})
	);
</script>

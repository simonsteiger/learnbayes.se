---
import { Icon } from 'astro-icon/components';
import type { ItemChip, Level } from '@lib/items';

interface Props {
	level?: Level;
	tags: string[];
	chips: ItemChip[];
	linksLabel: string;
}

const { level, tags, chips, linksLabel } = Astro.props;
const levelLabel = level ? { beginner: 'Beginner', intermediate: 'Intermediate', advanced: 'Advanced' }[level] : undefined;
---

<div class="panel not-content">
	{level && (
		<div class="row">
			<span class="key">Level</span>
			<span class={`level level--${level}`}>
				<span class="dot" aria-hidden="true"></span>
				{levelLabel}
			</span>
		</div>
	)}
	{tags.length > 0 && (
		<div class="row">
			<span class="key">Tags</span>
			<span class="tags">
				{tags.map((tag) => <span class="tag">{tag}</span>)}
			</span>
		</div>
	)}
	<div class="row">
		<span class="key">{linksLabel}</span>
		<span class="links">
			{chips.map((chip) =>
				chip.href ? (
					<a class="link" href={chip.href} target="_blank" rel="noopener noreferrer">
						{chip.iconUrl
							? <img src={chip.iconUrl} alt="" aria-hidden="true" width="18" height="18" />
							: <Icon name={chip.iconName!} width={18} height={18} />}
						{chip.label}
					</a>
				) : (
					<span class="link link--disabled" aria-disabled="true" title={`${chip.label} not available`}>
						{chip.iconUrl
							? <img src={chip.iconUrl} alt="" aria-hidden="true" width="18" height="18" />
							: <Icon name={chip.iconName!} width={18} height={18} />}
						{chip.label}
					</span>
				)
			)}
		</span>
	</div>
</div>

<style lang="scss">
	.panel {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.7rem;
		padding: 1rem 1.15rem;
		margin: 1.4rem 0;
	}

	.row {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.7rem;

		&:last-child {
			margin-bottom: 0;
		}
	}

	.key {
		flex: none;
		width: 4.5rem;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-gray-3);
	}

	.level {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;

		&--beginner { color: var(--level-beginner); }
		&--intermediate { color: var(--level-intermediate); }
		&--advanced { color: var(--level-advanced); }
	}

	.dot {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: currentColor;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;

		.tag:first-child {
			padding-left: 0;
		}
	}

	.tag {
		font-size: 0.72rem;
		color: var(--sl-color-gray-3);
		border-radius: 0.35rem;
		padding: 0.12rem 0.35rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.72rem;
		text-decoration: none;
		color: var(--sl-color-gray-3);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		padding: 0.35rem 0.7rem;
		transition: background-color 0.15s ease, border-color 0.15s ease;

		&:not(.link--disabled):hover {
			background-color: var(--color-accent-100);
			border-color: var(--color-accent-100);
		}

		&--disabled {
			opacity: 0.35;
			color: var(--sl-color-gray-3);
		}

		:global([data-theme='dark']) & {
		    // color
			&.link--disabled {
				opacity: 0.5;
				color: var(--sl-color-gray-5);
			}

			&:not(.link--disabled):hover {
				background-color: var(--color-accent-800);
				border-color: var(--color-accent-800);
			}
		}
	}
</style>

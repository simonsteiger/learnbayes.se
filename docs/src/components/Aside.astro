---
import { AstroError } from 'astro/errors';
import { Icon } from 'astro-icon/components';

const asideVariants = ['note', 'tip', 'caution', 'danger'] as const;
type AsideVariant = (typeof asideVariants)[number];

const icons: Record<AsideVariant, string> = {
	note: 'ph:info-duotone',
	tip: 'ph:lightbulb-duotone',
	caution: 'ph:warning-duotone',
	danger: 'ph:x-circle-duotone',
};

interface Props {
	type?: AsideVariant;
	title?: string;
}

const { type = 'note', title } = Astro.props;

if (!asideVariants.includes(type)) {
	throw new AstroError(
		'Invalid `type` prop passed to the `<Aside>` component.\n',
		`Received: ${JSON.stringify(type)}\n` +
			`Expected one of ${asideVariants.map((i) => JSON.stringify(i)).join(', ')}`
	);
}

---

<aside aria-label={title} class={`aside aside--${type}`}>
	{
		title && (
			<p class="aside__title" aria-hidden="true">
				<Icon name={icons[type]} class="aside__icon" />
				{title}
			</p>
		)
	}
	<div class="aside__content">
		<slot />
	</div>
</aside>

<style lang="scss">
	.aside {
		position: relative;
		padding: 1rem 1rem 1rem 1.25rem;
		color: var(--sl-color-text);
		background-color: var(--sl-color-gray-7);
		border-radius: 0.25rem;
		border-end-end-radius: 0.6rem;
		border-start-end-radius: 0.6rem;

		/* The accent bar replaces `border-inline-start` so its ends can be rounded
		   independently of the box. Only the outer (left) corners are rounded, so the
		   bar reads as the left edge of a rounded card; a right-hand bar would mirror
		   this. */
		&::before {
			content: '';
			position: absolute;
			inset-block: 0;
			inset-inline-start: 0;
			width: 0.3rem;
			border-start-start-radius: 0.6rem;
			border-end-start-radius: 0.6rem;
			background-color: var(--aside-accent);
		}

		&--note { --aside-accent: var(--color-secondary-dark); }
		&--tip { --aside-accent: var(--color-accent-500); }
		&--caution { --aside-accent: var(--level-advanced); }
		&--danger { --aside-accent: var(--level-expert); }

		:global([data-theme='dark']) & {
			background-color: var(--sl-color-gray-5);
			&--note { --aside-accent: var(--color-secondary-light); }
			&--tip { --aside-accent: var(--color-accent-200); }
			&--caution { --aside-accent: var(--level-advanced-light); }
			&--danger { --aside-accent: var(--level-expert-light); }
		}
	}

	.aside__title {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		font-size: var(--sl-text-h5);
		font-weight: 600;
		line-height: var(--sl-line-height-headings);
		color: var(--aside-accent);
	}

	.aside__icon {
		flex: none;
		font-size: 1.333em;
		width: 1em;
		height: 1em;
	}

	.aside__title + .aside__content {
		margin-top: 0.5rem;
	}

	.aside__content :global(a) {
		color: var(--aside-accent);
	}
</style>

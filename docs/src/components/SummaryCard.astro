---
import { Icon } from 'astro-icon/components';

interface Chip { label: string; count: number; svg?: string; ph?: string }
interface Props {
	title: string;
	href: string;
	description: string;
	chipLabel: string;
	chips: Chip[];
	levels: { beginner: number; advanced: number; expert: number };
	browseLabel: string;
}

const { title, href, description, chipLabel, chips, levels, browseLabel } = Astro.props;

// Resolve local SVG icon URLs at build time (same pattern as LangCard.astro).
const iconUrls = import.meta.glob<string>('@assets/img/icons/*.svg', {
	eager: true,
	query: '?url',
	import: 'default',
});
function iconUrl(name: string): string {
	const hit = Object.entries(iconUrls).find(([p]) => p.endsWith(`/${name}`));
	if (!hit) throw new Error(`SummaryCard: icon not found: ${name}`);
	return hit[1];
}

const levelRow = [
	{ key: 'beginner', count: levels.beginner },
	{ key: 'advanced', count: levels.advanced },
	{ key: 'expert', count: levels.expert },
] as const;
---

<a class="summary-card not-content" href={href}>
	<div class="summary-card__head">
		<h3 class="summary-card__title">{title}</h3>
		<span class="summary-card__browse">
			{browseLabel}
			<span class="summary-card__arrow" aria-hidden="true">&rarr;</span>
		</span>
	</div>
	<p class="summary-card__desc">{description}</p>

	<div class="summary-card__facets">
		<div class="summary-card__facet">
			<span class="summary-card__label">{chipLabel}</span>
			<div class="summary-card__chips">
				{chips.map((chip) => (
					<span class={`summary-chip${chip.count === 0 ? ' summary-chip--off' : ''}`}>
						{chip.svg ? (
							<img
								src={iconUrl(chip.count === 0 ? chip.svg.replace(/\.svg$/, '_grey.svg') : chip.svg)}
								alt=""
								aria-hidden="true"
								width="18"
								height="18"
							/>
						) : (
							<Icon name={chip.ph!} width={18} height={18} />
						)}
						<span class="summary-chip__label">{chip.label}</span>
						<span class="summary-chip__n">{chip.count}</span>
					</span>
				))}
			</div>
		</div>

		<div class="summary-card__facet">
			<span class="summary-card__label">Difficulty</span>
			<div class="summary-card__levels">
				{levelRow.map((l) => (
					<span class={`summary-level summary-level--${l.key}`}>
						<span class="summary-level__dot" aria-hidden="true"></span>
						<span class="summary-level__label">{l.key}</span>
						{l.count}
					</span>
				))}
			</div>
		</div>
	</div>
</a>

<style>
	.summary-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		padding: 1rem 1.15rem;
		background: var(--sl-color-black);
		text-decoration: none;
		color: inherit;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}
	.summary-card:hover {
		background-color: var(--color-accent-100);
		border-color: var(--sl-color-accent);
	}
	:global([data-theme='dark']) .summary-card:hover {
		background-color: var(--color-accent-800);
	}
	.summary-card__browse {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--sl-color-text-accent);
		white-space: nowrap;
		opacity: 0.55;
		transition: opacity 0.15s ease;
	}
	.summary-card__arrow {
		display: inline-block;
		transition: transform 0.15s ease;
	}
	.summary-card:hover .summary-card__browse { opacity: 1; }
	.summary-card:hover .summary-card__arrow { transform: translateX(4px); }
	.summary-card__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.summary-card__title {
		margin: 0;
		font-size: 1.15rem;
	}
	.summary-card__desc {
		margin: 0.15rem 0 0.4rem;
		color: var(--sl-color-gray-3);
		font-size: 0.9rem;
	}
	.summary-card__facets {
		display: flex;
		justify-content: space-between;
		flex-direction: column;
		gap: 0;
	}
	.summary-card__facet {
		min-width: 0;
	}
	.summary-card__label {
		font-size: 0.62rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-gray-3);
		margin: 0.7rem 0 0.4rem;
		display: block;
	}
	@media (min-width: 601px) {
		.summary-card__facets {
			flex-direction: row;
			gap: 1.5rem;
		}
		.summary-card__facet:first-child {
			flex: 1 1 auto;
		}
		.summary-card__facet:last-child {
			flex: 0 0 auto;
		}
		.summary-chip:last-child {
		    padding-left: 0;
		}
	}
	.summary-card__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.summary-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		// border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		padding: 0 0.42rem;
		font-size: 0.8rem;
	}
	.summary-chip:first-child {
	    padding-left: 0;
	}
	.summary-chip--off {
		opacity: 0.35;
	}
	:global([data-theme='dark']) .summary-chip--off {
		opacity: 0.5;
	}
	.summary-chip__n {
		font-weight: 700;
	}
	.summary-card__levels {
		display: flex;
		gap: 1.1rem;
	}
	.summary-level {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.85rem;
		font-weight: 600;
	}
	.summary-level__dot {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: currentColor;
	}
	.summary-level__label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border-width: 0;
	}
	.summary-level--beginner { color: #009E73; }
	.summary-level--advanced { color: #E69100; }
	.summary-level--expert   { color: #B84145; }
</style>

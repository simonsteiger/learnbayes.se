---
import { Icon } from 'astro-icon/components';
import { resolveIconUrl, greyVariant } from '@lib/icons';

interface Chip { label: string; count: number; svg?: string; ph?: string }
interface Props {
	title: string;
	href: string;
	description: string;
	chipLabel: string;
	chips: Chip[];
	levels: { beginner: number; advanced: number; expert: number };
	browseLabel: string;
}

const { title, href, description, chipLabel, chips, levels, browseLabel } = Astro.props;

const levelRow = [
	{ key: 'beginner', count: levels.beginner },
	{ key: 'advanced', count: levels.advanced },
	{ key: 'expert', count: levels.expert },
] as const;
---

<a class="summary-card not-content" href={href}>
	<div class="head">
		<h3 class="title">{title}</h3>
		<span class="browse">
			{browseLabel}
			<span class="arrow" aria-hidden="true">&rarr;</span>
		</span>
	</div>
	<p class="desc">{description}</p>

	<div class="facets">
		<div class="facet">
			<span class="label">{chipLabel}</span>
			<div class="chips">
				{chips.map((chip) => (
					<span class={`chip${chip.count === 0 ? ' chip--off' : ''}`}>
						{chip.svg ? (
							<img
								src={resolveIconUrl(chip.count === 0 ? greyVariant(chip.svg) : chip.svg)}
								alt=""
								aria-hidden="true"
								width="18"
								height="18"
							/>
						) : (
							<Icon name={chip.ph!} width={18} height={18} />
						)}
						<span class="chip__label">{chip.label}</span>
						<span class="chip__n">{chip.count}</span>
					</span>
				))}
			</div>
		</div>

		<div class="facet">
			<span class="label">Difficulty</span>
			<div class="levels">
				{levelRow.map((l) => (
					<span class={`level level--${l.key}`}>
						<span class="level__dot" aria-hidden="true"></span>
						<span class="level__label">{l.key}</span>
						{l.count}
					</span>
				))}
			</div>
		</div>
	</div>
</a>

<style lang="scss">
	.summary-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		padding: 1rem 1.15rem;
		background: var(--sl-color-black);
		text-decoration: none;
		color: inherit;
		transition: background-color 0.15s ease, border-color 0.15s ease;

		.head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 0.5rem;
		}

		.title {
			margin: 0;
			font-size: 1.15rem;
		}

		.browse {
			display: inline-flex;
			align-items: center;
			gap: 0.3rem;
			font-size: 0.8rem;
			font-weight: 600;
			color: var(--sl-color-text-accent);
			white-space: nowrap;
			opacity: 0.55;
			transition: opacity 0.15s ease;
		}

		.arrow {
			display: inline-block;
			transition: transform 0.15s ease;
		}

		@media (min-width: 600px) {
			&:hover {
			    .browse {
					opacity: 1;
				}
				.arrow {
				    transform: translateX(4px);
				}
				background-color: var(--color-accent-25);
				border-color: var(--color-accent-25);
			}
			:global([data-theme='dark']) & {
				&:hover {
					background-color: var(--color-accent-950);
					border-color: var(--color-accent-950);
				}
			}
		}

		.desc {
			margin: 0.15rem 0 0.4rem;
			color: var(--sl-color-gray-3);
			font-size: 0.9rem;
		}

		.facets {
			display: flex;
			justify-content: space-between;
			flex-direction: row;
			gap: 1.5rem;

			@media (max-width: 600px) {
				flex-direction: column;
				gap: 0;
			}
		}

		.facet {
			min-width: 0;

			&:first-child {
				flex: 1 1 auto;

				@media (max-width: 600px) {
					flex: initial;
				}
			}

			&:last-child {
				flex: 0 0 auto;

				@media (max-width: 600px) {
					flex: initial;
				}
			}
		}

		.label {
			font-size: 0.62rem;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--sl-color-gray-3);
			margin: 0.7rem 0 0.4rem;
			display: block;
		}

		.chips {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.levels {
			display: flex;
			gap: 1.1rem;
		}
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		// border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		padding: 0 0.42rem;
		font-size: 0.8rem;

		&:first-child {
			padding-left: 0;
		}

		&:last-child {
			padding-left: 0;

			@media (max-width: 600px) {
				padding-left: 0.42rem;
			}
		}

		&--off {
			opacity: 0.35;

			:global([data-theme='dark']) & {
				opacity: 0.5;
			}
		}

		&__label {
			@media (max-width: 600px) {
				display: none;
			}
		}

		&__n {
			font-weight: 700;
		}
	}

	.level {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.85rem;
		font-weight: 600;

		&__dot {
			width: 0.65rem;
			height: 0.65rem;
			border-radius: 50%;
			background: currentColor;
		}

		&__label {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border-width: 0;
		}

		&--beginner { color: var(--level-beginner); }
		&--advanced { color: var(--level-advanced); }
		&--expert   { color: var(--level-expert); }
	}
</style>

---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { formatTime, getCalendarEventLink, getSpeakerList } from "src/utils";

type Props = {
  event: CollectionEntry<"events">;
};

const { event } = Astro.props;
const { title, date, start_time, stop_time, place, type } = event.data;
const speakerList = await getSpeakerList(event);

const tomorrow = new Date();
tomorrow.setDate(tomorrow.getDate() + 1);
const isPastDate = date < tomorrow;

const calendarEventLink = await getCalendarEventLink(event);

const pastDateStyle =
  "bg-gray-600 group-hover:bg-gray-700 dark:bg-gray-300 dark:group-hover:bg-gray-400";
const futureDateStyle =
  "bg-accent-600 group-hover:bg-accent-700 dark:bg-accent-200 dark:group-hover:bg-accent-300";
---

<div
  class="not-content group flex dark:shadow-gray-700 rounded-md overflow-hidden"
  style="box-shadow: var(--sl-shadow-sm)"
>
  <a
    href={calendarEventLink}
    download={`${date.toISOString().slice(0, 10)} - Learn Bayes - ${title}.ics`}
    class={`block w-23 min-w-20 flex flex-shrink-0 flex-col items-center justify-center p-3 ${isPastDate ? pastDateStyle : futureDateStyle} text-white dark:text-gray-800 no-underline hover:no-underline`}
  >
    <div class="text-3xl">
      {date.toLocaleString("en-US", { day: "2-digit" })}
    </div>
    <div class="text-sm">
      {date.toLocaleString("en-US", { month: "long" })}
    </div>
  </a>
  <a
    href={'/' + event.id}
    class="block flex flex-grow py-2 px-4 rounded-r-md border-y border-r border-gray-300 dark:border-gray-500 bg-white group-hover:bg-gray-100 dark:bg-gray-800 dark:group-hover:bg-gray-700 no-underline hover:no-underline"
  >
    <div class="flex-grow flex flex-col text-gray-900 dark:text-gray-200">
      <div
        class="flex items-start gap-3 text-lg font-semibold"
      >
        <div class="flex-grow">{title}</div>
        <div class="flex-shrink-0">
          <Icon
            class="inline-block align-text-bottom"
            is:inline={true}
            name={place.toLowerCase().startsWith("zoom") ? "mdi:video-chat" : "mdi:lecture"}
          />
        </div>
      </div>
      <div class="text-gray-800 dark:text-gray-300">
        {formatTime(start_time)}-{formatTime(stop_time)} / {type} with {
          speakerList
        }
      </div>
    </div>
  </a>
</div>

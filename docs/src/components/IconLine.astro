---
import { Icon } from 'astro-icon/components';

interface Props {
	icon: string;
}

const { icon } = Astro.props;
---

<p class="icon-line">
	<Icon name={icon} class="icon-line__icon" />
	<span><slot /></span>
</p>

<style lang="scss">
	.icon-line {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0;

		/* Lines stack tighter than surrounding prose so a run of them reads as one block. */
		& + & {
			margin-top: 0.3rem;
		}
	}

	.icon-line__icon {
		flex: none;
		font-size: 1.25em;
		width: 1em;
		height: 1em;
		/* Baseline alignment puts the glyph box too high; nudge it onto the text baseline. */
		transform: translateY(0.15em);
	}
</style>

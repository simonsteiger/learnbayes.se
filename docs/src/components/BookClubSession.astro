---
import { LinkButton } from '@astrojs/starlight/components';
import { Icon } from 'astro-icon/components';
import IconLine from '@components/IconLine.astro';
import { formatList, formatTime, getBookClubCalendarEventLink, pluralise, setTime, type Lecture } from 'src/utils';

interface SessionLink {
	label: string;
	href: string;
	/** Iconify name, e.g. `ph:presentation-chart-duotone`. */
	icon?: string;
}

interface Props {
	/** Calendar date of the session as `YYYY-MM-DD`. */
	date: string;
	/** Chapters of Statistical Rethinking, e.g. `[1, 2]`. */
	chapters: number[];
	/** Accompanying video lectures, e.g. `[{ label: 'A01', url: '…' }]`. */
	lectures: Lecture[];
	startTime?: string;
	stopTime?: string;
	place?: string;
	/** Extra buttons shown after "Add to calendar". */
	links?: SessionLink[];
}

const {
	date,
	chapters,
	lectures,
	startTime ='15:00:00',
	stopTime = '17:00:00',
	place = 'Widerströmska huset, Room Karolina',
	links = [],
} = Astro.props;

if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
	throw new Error(`BookClubSession: \`date\` must be YYYY-MM-DD, received ${JSON.stringify(date)}`);
}

if (chapters.length === 0) {
	throw new Error(`BookClubSession: \`chapters\` must not be empty (session on ${date})`);
}

if (lectures.length === 0) {
	throw new Error(`BookClubSession: \`lectures\` must not be empty (session on ${date})`);
}

const remainingLectures = [...lectures];
const lectureListParts = new Intl.ListFormat('en')
	.formatToParts(lectures.map(({ label }) => label))
	.map(({ type, value }) => (type === 'element' ? remainingLectures.shift()! : value));

const day = new Date(date);
const longDate = day.toLocaleDateString('en-GB', {
	weekday: 'long',
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});

const calendarEventLink = getBookClubCalendarEventLink({
	start: setTime(day, startTime),
	end: setTime(day, stopTime),
	place,
	chapters,
	lectures,
});
---

<div class="session">
	<IconLine icon="ph:calendar-dots-duotone">
		<strong>{longDate}</strong>, {formatTime(startTime)}–{formatTime(stopTime)}
	</IconLine>
	<IconLine icon="ph:map-pin-duotone">{place}</IconLine>
	<IconLine icon="ph:books-duotone">
		{`${pluralise('Chapter', chapters.length)} ${formatList(chapters)}, video ${pluralise('lecture', lectures.length)} `}
		{lectureListParts.map((part) => (typeof part === 'string' ? part : <a href={part.url}>{part.label}</a>))}
	</IconLine>

	{
		Astro.slots.has('default') && (
			<div class="session__details">
				<slot />
			</div>
		)
	}

	<div class="session__buttons">
		<LinkButton href={calendarEventLink} download={`${date} - Learn Bayes - Book Club.ics`}>
			<Icon name="ph:calendar-plus-duotone" class="session__button-icon" />
			Add to calendar
		</LinkButton>
		{
			links.map(({ label, href, icon }) => (
				<LinkButton href={href}>
					{icon && <Icon name={icon} class="session__button-icon" />}
					{label}
				</LinkButton>
			))
		}
	</div>
</div>

<style lang="scss">
	.session {
		margin-bottom: 4rem;
	}

	.session__details {
		margin-top: 1rem;
	}

	.session__button-icon {
		font-size: 1.25em;
		width: 1em;
		height: 1em;
	}

	.session__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.25rem;
	}

	.session :global(.sl-link-button) {
		margin: 0;
		border-radius: 0.6rem;
	}
</style>

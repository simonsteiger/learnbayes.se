---
import { LinkButton } from '@astrojs/starlight/components';
import { Icon } from 'astro-icon/components';
import IconLine from '@components/IconLine.astro';
import { formatTime, getBookClubCalendarEventLink, setTime } from 'src/utils';

interface Props {
	/** Calendar date of the session as `YYYY-MM-DD`. */
	date: string;
	/** Chapter range of Statistical Rethinking, e.g. `1-2`. */
	chapters: string;
	/** Label of the accompanying video lecture, e.g. `A01`. */
	lecture: string;
	lectureUrl: string;
	startTime?: string;
	stopTime?: string;
	place?: string;
}

const {
	date,
	chapters,
	lecture,
	lectureUrl,
	startTime ='15:00:00',
	stopTime = '17:00:00',
	place = 'Widerströmska huset, Room Karolina',
} = Astro.props;

if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
	throw new Error(`BookClubSession: \`date\` must be YYYY-MM-DD, received ${JSON.stringify(date)}`);
}

const day = new Date(date);
const longDate = day.toLocaleDateString('en-GB', {
	weekday: 'long',
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});

const calendarEventLink = getBookClubCalendarEventLink({
	start: setTime(day, startTime),
	end: setTime(day, stopTime),
	place,
	chapters,
	lecture,
	lectureUrl,
});
---

<div class="session">
	<IconLine icon="ph:calendar-dots-duotone">
		<strong>{longDate}</strong>, {formatTime(startTime)}–{formatTime(stopTime)}
	</IconLine>
	<IconLine icon="ph:map-pin-duotone">{place}</IconLine>
	<IconLine icon="ph:books-duotone">
		Chapters {chapters}, <a href={lectureUrl}>video lecture {lecture}</a> 
	</IconLine>

	{
		Astro.slots.has('default') && (
			<div class="session__details">
				<slot />
			</div>
		)
	}

	<LinkButton href={calendarEventLink} download={`${date} - Learn Bayes - Book Club.ics`}>
		<Icon name="ph:calendar-plus-duotone" class="session__button-icon" />
		Add to calendar
	</LinkButton>
</div>

<style lang="scss">
	.session {
		margin-bottom: 4rem;
	}

	.session__details {
		margin-top: 1rem;
	}

	.session__button-icon {
		font-size: 1.25em;
		width: 1em;
		height: 1em;
	}

	.session :global(.sl-link-button) {
		margin-top: 1.25rem;
		border-radius: 0.6rem;
	}
</style>

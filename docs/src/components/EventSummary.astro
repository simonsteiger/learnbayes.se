---
import { formatTime } from "src/utils";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
type ImageModule = { default: ImageMetadata };

import { getSpeakerList } from "src/utils";

type Props = {
  eventID: string;
};

const { eventID } = Astro.props;
const event = await getEntry("events", eventID);

if (!event) {
  return;
}

const speakers = event?.data.speaker;

const speakerList = await getSpeakerList(event);

const date = new Date(event.data.date);
const start_time = formatTime(event.data.start_time);
const stop_time = formatTime(event.data.stop_time);
const { place, type, url } = event.data;

// Get portrait file paths without loading them
const portraits = import.meta.glob<ImageModule>(
  "@assets/portraits/*.{jpeg,jpg,png}",
);
const portraitMap = Object.keys(portraits).reduce(
  (acc, path) => {
    const filename = path.split("/").pop()?.split(".")[0] ?? "";
    const key = filename.replace("portrait-", "");
    acc[key] = path;
    return acc;
  },
  {} as Record<string, string>,
);

let portrait;
if (speakers?.length == 1 && speakers[0]["id"] in portraitMap) {
  const imported = await portraits[portraitMap[speakers[0]["id"]]]();
  portrait = imported.default;
} else {
  // Default portrait here
}
---

<div class="not-content flex flex-col p-4 gap-4 bg-gray-100 dark:bg-gray-800">
  <div class="flex flex-col sm:flex-row gap-4">
    {
      portrait && (
        <div class="flex md:w-auto items-center justify-center">
          <Image height="130" src={portrait} alt={`Portrait of speaker`} />
        </div>
      )
    }
    <div class="flex flex-col flex-grow justify-center">
      <span><strong>Speaker:</strong> {speakerList}</span>
      <span
        ><strong>Date & time:</strong>
        {date.toDateString()}, {start_time}-{stop_time} (CET)</span
      >
      <span><strong>Place:</strong> {place}</span>
      <span><strong>Type:</strong> {type}</span>
      {
        url && (
          <span>
            <strong>URL:</strong>
            <a href={url} target="_blank" rel="noopener noreferrer">
              {url}
            </a>
          </span>
        )
      }
    </div>
  </div>
  <div class="font-bold text-center">
    {
      place.toLowerCase().startsWith("zoom") ? (
        <>
          <Icon class="align-text-bottom" name="mdi:video-chat" />
          This is an online event. Zoom link will be provided through the email
          list.
        </>
      ) : (
        <>
          <Icon class="align-text-bottom" name="mdi:lecture" />
          This is an in-person event only. No zoom link will be provided.
        </>
      )
    }
  </div>
</div>

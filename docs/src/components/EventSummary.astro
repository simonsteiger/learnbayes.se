---
import { formatTime, getCalendarEventLink } from "src/utils";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
type ImageModule = { default: ImageMetadata };

import { getSpeakerList } from "src/utils";

type Props = {
  eventID: string;
};

const { eventID } = Astro.props;
const event = await getEntry("events", eventID);

if (!event) {
  return;
}

const speakers = event.data.speaker;
const eventImage = event.data.image;

const speakerList = await getSpeakerList(event);

const date = new Date(event.data.date);
const start_time = formatTime(event.data.start_time);
const stop_time = formatTime(event.data.stop_time);
const { place, type, url } = event.data;
const cestStart = new Date("2025-03-30T00:00:00Z");
const isCest = date > cestStart;

// Get portrait file paths without loading them
const images = import.meta.glob<ImageModule>("@assets/img/**/*.{jpeg,jpg,png}");

const imageMap = Object.keys(images).reduce(
  (acc, path) => {
    const name = path.split("/").slice(-2).join("/").split(".")[0] ?? "";
    acc[name] = path;
    return acc;
  },
  {} as Record<string, string>,
);

let image;
if (eventImage in imageMap) {
  const imported = await images[imageMap[eventImage]]();
  image = imported.default;
} else {
  // Default image here, currently no image
}

const calendarEventLink = await getCalendarEventLink(event);
---

<>
  {
    date.setHours(0, 0, 0, 0) >= new Date().setHours(0, 0, 0, 0) && (
      <div class="text-center">
        📆
        <a
          href={calendarEventLink}
          download={`${date.toLocaleDateString("se")} - Learn Bayes - ${event.data.title}.ics`}
        >
          <span>
            <strong>Download Calendar Event</strong>
          </span>
          <span class="hidden md:inline">
            <strong>: </strong>Learn Bayes - {event.data.title}
          </span>
        </a>
      </div>
    )
  }

  <div
    class="not-content flex flex-col p-4 gap-4 bg-gray-100 dark:bg-gray-800 rounded-sm"
  >
    <div class="flex flex-col sm:flex-row gap-4">
      {
        image && (
          <div class="flex md:w-auto items-center justify-center">
            <Image
              height="130"
              src={image}
              alt={`Portrait of speaker`}
              class="border-4 border-white rounded-sm"
            />
          </div>
        )
      }
      <div class="min-w-0 flex flex-col flex-grow justify-center">
        <span><strong>Speaker: </strong>{speakerList}</span>
        <span
          ><strong>Date & time: </strong>
          {date.toDateString()}, {start_time}-{stop_time}
          {isCest ? " (CEST)" : " (CET)"}</span
        >
        <span><strong>Place: </strong>{place}</span>
        <span><strong>Type: </strong>{type}</span>
        {
          url && (
            <span class="inline-block truncate">
              <strong>URL: </strong>
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent-600"
              >
                {url}
              </a>
            </span>
          )
        }
      </div>
    </div>
    <div class="font-bold text-center">
      {
        place.toLowerCase().startsWith("zoom") ? (
          <>
            <Icon class="align-text-bottom" name="mdi:video-chat" />
            This is an online event. Zoom link will be provided through the
            email list.
          </>
        ) : (
          <>
            <Icon class="align-text-bottom" name="mdi:lecture" />
            This is an in-person event only. No zoom link will be provided.
          </>
        )
      }
    </div>
  </div>
</>

---
import { Aside } from "@astrojs/starlight/components";
import { formatTime, getSpeaker } from "src/utils";

type Props = {
  frontmatter: {
    title: string;
    speaker: string;
    date: string;
    start_time: string;
    stop_time: string;
    place: string;
    type: string;
    group: string;
  };
};

const { frontmatter } = Astro.props;
const speaker = getSpeaker(frontmatter.speaker);
const date = new Date(frontmatter.date);
const start_time = formatTime(frontmatter.start_time);
const stop_time = formatTime(frontmatter.stop_time);
const { place, type } = frontmatter;
---

<Aside title="Summary">
  <strong>Speaker:</strong>
  {speaker?.data.title}<br />
  <strong>Date & time:</strong>
  {date.toDateString()}, {start_time}-{stop_time}<br />
  <strong>Place:</strong>
  {place}<br />
  <strong>Type:</strong>
  {type}
</Aside>

---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getEntry, render } from 'astro:content';
import ItemDetail from '@components/ItemDetail.astro';
import { loadItems, type Item } from '@lib/items';

export async function getStaticPaths() {
	const items = await loadItems('resources');
	return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props {
	item: Item;
}

const { item } = Astro.props;
const entry = await getEntry('resources', item.id);
if (!entry) throw new Error(`resources entry not found: ${item.id}`);
const { Content, headings } = await render(entry);
---

<StarlightPage
	frontmatter={{
		title: item.title,
		description: item.description,
		tableOfContents: headings.length > 0 ? undefined : false,
	}}
	headings={headings}
>
	<ItemDetail
		item={item}
		breadcrumbLabel="Resources"
		breadcrumbHref="/learn/resources/"
		linksLabel="Links"
	>
		<Content />
	</ItemDetail>
</StarlightPage>
